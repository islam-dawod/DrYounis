# =============================================================
#  Younis Clinic — static site .htaccess
#  1) 301 redirects from the old WordPress URLs (SEO preservation)
#  2) Clean (extension-less) URLs for .html files
#  Works on Apache/LiteSpeed with mod_rewrite enabled.
# =============================================================

Options +FollowSymLinks -MultiViews
DirectoryIndex index.html index.htm index.php
RewriteEngine On
RewriteBase /

# ---- 1) OLD WORDPRESS URLS -> NEW PAGES (301) --------------------------------
# Only slugs that DIFFER from the new clean URLs are redirected here.
# (/about and /instructions are served directly from about.html / instructions.html
#  by the clean-URL rules below, so the old /about/ and /instructions/ keep working
#  without a redirect loop.)
RewriteRule ^contact-us/?$                     /contact [R=301,L]
RewriteRule ^(dental-implant|zeraah)/?$        /treatment-implant [R=301,L]
RewriteRule ^(taj|tarqe3|jeraha|khale3|white|whitening|lethah|lethah3elaj|jeob|clean|scaling-deep-cleaning|root|mouth|bruxism|qoshor|tarmem|inlay-onlay|7asho|tooth-removal|serviceshe)/?$ /treatments [R=301,L]

# ---- 2) Canonical: /page.html -> /page (301) --------------------------------
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 3) Internally serve /page from /page.html ------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
