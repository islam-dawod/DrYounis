# =============================================================
#  Younis Clinic — static site .htaccess
#  1) 301 redirects from the old WordPress URLs (SEO preservation)
#  2) Clean (extension-less) URLs for .html files
#  Works on Apache/LiteSpeed with mod_rewrite enabled.
# =============================================================

Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# ---- 1) OLD WORDPRESS URLS -> NEW PAGES (301) --------------------------------
# Core pages
RewriteRule ^about/?$                         /about [R=301,L]
RewriteRule ^contact-us/?$                     /contact [R=301,L]
RewriteRule ^instructions/?$                   /instructions [R=301,L]

# Implants -> dedicated implant page
RewriteRule ^(dental-implant|zeraah)/?$        /treatment-implant [R=301,L]

# All other old treatment/service pages -> treatments hub
RewriteRule ^(taj|tarqe3|jeraha|khale3|white|whitening|lethah|lethah3elaj|jeob|clean|scaling-deep-cleaning|root|mouth|bruxism|qoshor|tarmem|inlay-onlay|7asho|tooth-removal|serviceshe|serviceshe)/?$ /treatments [R=301,L]

# ---- 2) Canonical: /page.html -> /page (301) --------------------------------
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 3) Internally serve /page from /page.html ------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ---- 4) Optional: 404 fallback to home (uncomment if desired) ----------------
# ErrorDocument 404 /index.html
