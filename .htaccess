# =============================================================
#  Younis Clinic — static site .htaccess
#  1) 301 redirects from the old WordPress URLs (SEO preservation)
#  2) Clean (extension-less) URLs for .html files
#  Works on Apache/LiteSpeed with mod_rewrite enabled.
# =============================================================

Options +FollowSymLinks -MultiViews
DirectoryIndex index.html index.htm index.php
RewriteEngine On
RewriteBase /

# ---- 1) OLD WORDPRESS URLS -> NEW PAGES (301) --------------------------------
# Only slugs that DIFFER from the new clean URLs are redirected here.
# (/about and /instructions are served directly from about.html / instructions.html
#  by the clean-URL rules below, so the old /about/ and /instructions/ keep working
#  without a redirect loop.)
# Consolidate home: /index and /index.html -> /
RewriteRule ^index(\.html)?/?$                  / [R=301,L]
RewriteRule ^contact-us/?$                     /contact [R=301,L]
RewriteRule ^dental-implant/?$                  /treatments/dental-implants [R=301,L]
# Legacy treatment slugs -> approved nested English routes
RewriteRule ^7asho/?$                           /treatments/filling [R=301,L]
RewriteRule ^inlay-onlay/?$                      /treatments/inlay-onlay [R=301,L]
RewriteRule ^tooth-removal/?$                    /treatments/tooth-extraction [R=301,L]
RewriteRule ^(whitening)/?$                      /treatments/teeth-whitening [R=301,L]
RewriteRule ^root/?$                             /treatments/root-canal [R=301,L]
RewriteRule ^(lethah3elaj|scaling-deep-cleaning)/?$ /treatments/periodontal-treatment [R=301,L]
RewriteRule ^qoshor/?$                           /treatments/veneers [R=301,L]
RewriteRule ^mouth/?$                            /treatments/crowns-bridges [R=301,L]
# Legacy patient-instruction slugs -> approved nested English routes
RewriteRule ^zeraah/?$                           /instructions/dental-implant [R=301,L]
RewriteRule ^khale3/?$                           /instructions/surgical-extraction [R=301,L]
RewriteRule ^jeob/?$                             /instructions/sinus-lift [R=301,L]
RewriteRule ^lethah/?$                           /instructions/periodontal-surgery [R=301,L]
RewriteRule ^taj/?$                              /instructions/crown-lengthening [R=301,L]
RewriteRule ^jeraha/?$                           /instructions/regenerative-surgery [R=301,L]
RewriteRule ^tarqe3/?$                           /instructions/gum-graft [R=301,L]
RewriteRule ^white/?$                            /instructions/whitening [R=301,L]
RewriteRule ^tarmem/?$                           /instructions/removable-prosthesis [R=301,L]
RewriteRule ^clean/?$                            /instructions/oral-hygiene [R=301,L]
RewriteRule ^(bruxism|serviceshe)/?$             /treatments [R=301,L]
# Old flat implant-instruction URL -> new canonical nested route
RewriteRule ^instruction-implant/?$             /instructions/dental-implant [R=301,L]

# ---- 2) Canonical: /page.html -> /page (301) --------------------------------
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 2b) Approved NESTED routes -> flat page files (internal) ----------------
# Main approved treatment pages (nested aliases)
RewriteRule ^treatments/dental-implants/?$      /treatment-implant.html [L]
RewriteRule ^treatments/crowns-bridges/?$       /treatment-crowns.html [L]
RewriteRule ^treatments/full-mouth/?$           /treatment-full-mouth.html [L]
# Additional treatment pages + veneers (flat file names match slug)
RewriteRule ^treatments/([a-z0-9-]+)/?$         /treatment-$1.html [L]
# Patient instruction pages
RewriteRule ^instructions/([a-z0-9-]+)/?$       /instruction-$1.html [L]
# Digital business card (short URL + future per-member alias)
RewriteRule ^card/tahsin/?$                     /card.html [L]

# ---- 3) Internally serve /page from /page.html ------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
